{
  "id": "wr_simulated",
  "schema_version": 1,
  "workflow": "rpiv",
  "title": "Research, Plan, Implement, Verify",
  "definition": {
    "id": "rpiv",
    "title": "Research, Plan, Implement, Verify",
    "description": "One feature end to end in one workspace, with a plan gate and a test-backed verify loop.",
    "use_when": "A feature or change to build end to end, with a plan to approve first.",
    "applies_to": [],
    "inputs": {
      "task": {
        "description": "What to build. A ticket key with a sentence, or a path to a spec in the worktree. `workflow run` fills it from the open pull request, else `Branch NAME`, when left out.",
        "required": true
      },
      "spec": {
        "description": "Optional spec or ticket file to read first.",
        "required": false
      }
    },
    "include": [],
    "instructions": "You are working on {{inputs.task}} in workspace {{workspace}}, branch {{branch}}.\nSpec (may be empty): {{inputs.spec}}\nEvery artifact for this run goes under {{artifacts}}/. Earlier steps' artifacts are\ninputs; read them before you start.\n",
    "max_attempts": 10,
    "stall": null,
    "redeliver": 3,
    "deny": [],
    "steps": [
      {
        "id": "research",
        "title": "Research",
        "prompt": "Research {{inputs.task}}. Read the code it touches, the tests that cover it, and\nrelated docs. Don't change code or commit.\nWrite {{artifacts}}/research.md with: what exists (file:line), what has to change,\nconstraints, open questions, risks.\n",
        "include": [],
        "produces": [
          "research.md"
        ],
        "status": null,
        "gate": null,
        "guard": "unchanged",
        "require": [],
        "uses": [],
        "on_fail": null,
        "context": "fresh",
        "timeout": 2700.0,
        "on_timeout": "warn",
        "max_attempts": null
      },
      {
        "id": "plan",
        "title": "Plan",
        "prompt": "Using {{artifacts}}/research.md, write the plan as the workspace plan: the\nIMPLEMENTATION_PLAN.md that `workspace plan path` names (run `workspace plan init --title \"<title>\"` first if it does not exist), in the syntax the\nimplementation-plan instructions give, so `workspace plan status` shows it.\nOne task per commit, in order, with the files touched, tests to add and how you'll\nknow it works under that task in Task details. Call out anything that needs the\ndev environment or the test database. Set `status: active` and leave every task `[ ]`.\nYou only write the plan here; do not start any task, and do not set `status: done`.\nThen write {{artifacts}}/plan.md for the approval gate: the approach, the risks, and\nthe path of the plan file. Do not copy the task list into it. The step is not\nfinished until plan.md exists.\nDon't change code.\n",
        "include": [
          "notes",
          "implementation-plan"
        ],
        "produces": [
          "plan.md"
        ],
        "status": {
          "run": "workspace plan status --json | ruby -rjson -e 'plan = JSON.parse($stdin.read)[\"plans\"].to_a.first; exit(plan && plan[\"exists\"] && plan[\"counts\"][\"total\"].to_i > 0 ? 0 : 1)'\n",
          "timeout": 1200
        },
        "gate": "approve",
        "guard": "unchanged",
        "require": [],
        "uses": [],
        "on_fail": null,
        "context": "fresh",
        "timeout": 2700.0,
        "on_timeout": "warn",
        "max_attempts": null
      },
      {
        "id": "implement",
        "title": "Implement",
        "prompt": "Implement the workspace plan (`workspace plan path`) one task at a time, marking\neach task as the instructions say. Run the relevant tests before each commit. If the\nplan turns out wrong, update the plan file and say why in {{artifacts}}/implement.md.\nWrite {{artifacts}}/implement.md listing the commits you made, then set the plan's\n`status: done`; the run is waiting on that file and on that status. Make at least one commit.\nOn a rerun (after a failed verify, or a resume), make a new commit for the fix and never\namend or rebase, which the run's commit check can't follow. If no code change is needed,\nrun `git commit --allow-empty -m '<why>'`.\n",
        "include": [
          "notes",
          "implementation-plan"
        ],
        "produces": [
          "implement.md"
        ],
        "status": null,
        "gate": null,
        "guard": null,
        "require": [
          {
            "commits": 1
          },
          {
            "plan_status": "done"
          }
        ],
        "uses": [],
        "on_fail": null,
        "context": "fresh",
        "timeout": 10800.0,
        "on_timeout": "warn",
        "max_attempts": null
      },
      {
        "id": "verify",
        "title": "Verify",
        "prompt": "Verify the work against the workspace plan (`workspace plan path`). Run the tests for the\nfiles the change touched, their obvious neighbors, and the tests the change obviously\nimpacts — not the whole suite (it runs on CI). Run the linter (the project's lint\ncommand, when it has one, must pass: the run checks it), then review the branch's diff against its base.\nWrite {{artifacts}}/verify.md: test results, review findings, and what you fixed.\nIf anything blocking remains, run `workspace step done --status fail --summary \"<what is left>\"`\nand end your turn.\n",
        "include": [
          "review"
        ],
        "produces": [
          "verify.md"
        ],
        "status": {
          "command": "test",
          "timeout": 1200
        },
        "gate": null,
        "guard": null,
        "require": [
          {
            "command": "lint",
            "optional": true
          }
        ],
        "uses": [
          "test-db"
        ],
        "on_fail": {
          "goto": "implement",
          "max": 3,
          "context": "continue"
        },
        "context": "fresh",
        "timeout": 5400.0,
        "on_timeout": "warn",
        "max_attempts": null
      }
    ],
    "produces_check": "strict"
  },
  "definition_source": "builtin",
