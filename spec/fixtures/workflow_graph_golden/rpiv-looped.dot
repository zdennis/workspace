digraph workflow {
  rankdir=LR;
  labelloc=b;
  label="max_attempts 10";
  ".start" [shape=point];
  "research" [shape=box, label="Research [passed]", style=filled, fillcolor="#d4edda"];
  "plan" [shape=box, label="Plan [passed]", style=filled, fillcolor="#d4edda"];
  "plan.gate" [shape=diamond, label="Plan gate [passed]", style=filled, fillcolor="#d4edda"];
  "implement" [shape=box, label="Implement [passed x3]", style=filled, fillcolor="#d4edda"];
  "verify" [shape=box, label="Verify [current, 3 attempts]", style=filled, fillcolor="#cce5ff"];
  ".end" [shape=doublecircle, label=""];
  ".start" -> "research";
  "research" -> "plan";
  "plan" -> "plan.gate";
  "plan.gate" -> "implement";
  "implement" -> "verify";
  "verify" -> ".end";
  "verify" -> "implement" [style=dashed, label="fail: max 3 (looped 2)"];
  "plan.gate" -> "plan" [style=dashed, label="reject (or --to an earlier step)"];
}
