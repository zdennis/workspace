#!/usr/bin/env ruby
# A git merge driver for demo/calculator2/test/calc_test.rb: `merge_test_methods %O %A %B` (ancestor, ours, theirs).
#
# The result is ours with theirs' changes merged method by method, three-way against the ancestor. A method is a two-space
# `def` block and the comment lines right above it, test or helper. What theirs added goes in: each new method before the test
# class's final `end`, each new top-level `require` line after ours' last one. What theirs changed or removed, where ours left
# the method as the ancestor had it, is taken from theirs. Lane B's goals need this: --json needs a require, the REPL needs
# helpers that take flags and stdin, and goal 07 changes what a bare `calc` does, so an earlier test changes or goes.
#
# It writes the result to %A and exits 0, or exits 1 and leaves %A alone when it cannot do that safely: both sides changed the
# same method, one changed a method the other removed, a new name is in both sides with different bodies, theirs changed any
# other line outside the methods, or the result does not parse. Git then reports a conflict.
require_relative "test_names"

module MergeTestMethods
  Conflict = Class.new(StandardError)
  Block = Struct.new(:name, :lines)

  METHOD_END = /\A  end\s*\z/
  DEF_START = /\A  def ((?:self\.)?\w+[?!]?)/
  ENDLESS_DEF = /\A  def (?:self\.)?\w+[?!]?(?:\([^)]*\))?\s*=(?![=~>])/
  REQUIRE = /\Arequire(_relative)? ["']/

  # @return [Array(Array<Block>, Array<String>)] the two-space method blocks of a file (tests and helpers), and its other
  #   non-blank lines
  def self.split(text)
    lines = text.lines
    blocks = []
    taken = Array.new(lines.size, false)
    lines.each_with_index do |line, index|
      next unless (name = line[DEF_START, 1])
      finish = line.match?(ENDLESS_DEF) ? index : (index...lines.size).find { |at| lines[at].match?(METHOD_END) }
      raise Conflict, "#{name} has no closing end at two spaces" unless finish
      inner = ((index + 1)...finish).find { |at| lines[at].match?(DEF_START) }
      raise Conflict, "#{lines[inner][DEF_START, 1]} starts inside #{name}, so the methods cannot be told apart" if inner
      first = index
      first -= 1 while first > 0 && lines[first - 1].start_with?("  #") && !taken[first - 1]
      (first..finish).each { |at| taken[at] = true }
      blocks << Block.new(name, lines[first..finish])
    end
    rest = lines.each_with_index.reject { |line, at| taken[at] || line.strip.empty? }.map(&:first)
    [blocks, rest]
  end

  # @return [String] the merged file
  # @raise [Conflict] when the merge is not just what theirs added
  def self.merge(ancestor, ours, theirs)
    base_blocks, base_rest = split(ancestor)
    our_blocks, our_rest = split(ours)
    their_blocks, their_rest = split(theirs)
    requires = (their_rest - base_rest).select { |line| line.match?(REQUIRE) }
    raise Conflict, "theirs changed lines outside the methods" unless their_rest - requires == base_rest
    [["theirs", their_blocks], ["ours", our_blocks]].each do |side, blocks|
      twice = blocks.map(&:name).tally.find { |_, count| count > 1 }
      raise Conflict, "#{side} defines #{twice[0]} twice" if twice
    end
    theirs_by_name = their_blocks.to_h { |block| [block.name, block] }
    ours_by_name = our_blocks.to_h { |block| [block.name, block] }
    changed = []
    base_blocks.each do |block|
      same = theirs_by_name[block.name]
      next if same && same.lines == block.lines
      mine = ours_by_name[block.name]
      next if same.nil? && mine.nil?
      next if mine && same && mine.lines == same.lines
      raise Conflict, "both sides changed #{block.name} (theirs #{same ? "changed" : "removed"} it, ours #{mine ? "changed" : "removed"} it)" unless mine && mine.lines == block.lines
      changed << [mine, same]
    end
    base_names = base_blocks.map(&:name)
    added = their_blocks.reject { |block| base_names.include?(block.name) }
    added.each do |block|
      mine = ours_by_name[block.name]
      raise Conflict, "#{block.name} is in both sides with different bodies" if mine && mine.lines != block.lines
    end
    added = added.reject { |block| ours_by_name.key?(block.name) }
    requires -= our_rest
    return ours if added.empty? && changed.empty? && requires.empty?
    text = ours
    changed.each do |mine, same|
      raise Conflict, "ours has #{mine.name} more than once as text" unless text.scan(mine.lines.join).size == 1
      old = mine.lines.join
      if same.nil? && text.include?(old + "\n")
        old += "\n"
      elsif same.nil? && text.include?("\n" + old)
        old = "\n" + old
      end
      text = text.sub(old) { same ? same.lines.join : "" }
    end
    lines = text.lines
    unless requires.empty?
      after = lines.rindex { |line| line.match?(REQUIRE) }
      raise Conflict, "ours has no top-level require to add #{requires.first.strip} after" unless after
      lines.insert(after + 1, *requires)
    end
    unless added.empty?
      last = lines.rindex { |line| !line.strip.empty? }
      raise Conflict, "ours has no final end" unless last && lines[last].match?(/\Aend\s*\z/)
      head = lines[0...last]
      head.pop while head.last&.strip&.empty?
      head << "\n"
      inserted = added.flat_map { |block| block.lines + ["\n"] }
      inserted.pop
      lines = head + inserted + lines[last..]
    end
    result = lines.join
    check_syntax!(result)
    result
  end

  def self.check_syntax!(text)
    RubyVM::InstructionSequence.compile(text)
  rescue SyntaxError => e
    raise Conflict, "the merged file does not parse: #{e.message.lines.first}"
  end

  # @return [Integer] exit status
  def self.run(argv, err: $stderr)
    return 2.tap { err.puts "usage: merge_test_methods ANCESTOR OURS THEIRS" } unless argv.size == 3
    ancestor, ours, theirs = argv.map { |path| File.read(path) }
    result = merge(ancestor, ours, theirs)
    File.write(argv[1], result) unless result.equal?(ours)
    0
  rescue Conflict, SystemCallError => e
    err.puts "merge_test_methods: #{e.message}"
    1
  end
end

exit MergeTestMethods.run(ARGV) if $PROGRAM_NAME == __FILE__
