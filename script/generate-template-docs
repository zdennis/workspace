#!/usr/bin/env ruby
# Rewrites the generated blocks of docs/README.template.md from
# Workspace::TemplateVariables.
#
#   script/generate-template-docs            rewrite docs/README.template.md
#   script/generate-template-docs --check    exit 1 if it is out of date, change nothing
#   script/generate-template-docs [--check] PATH   use another file

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "workspace"

check = ARGV.delete("--check")
path = ARGV.first || File.expand_path("../docs/README.template.md", __dir__)

current = File.read(path)
updated = Workspace::TemplateVariablesDocs.rewrite(current)

if updated == current
  puts "#{path} is up to date."
elsif check
  warn "#{path} is out of date; run script/generate-template-docs."
  exit 1
else
  File.write(path, updated)
  puts "Rewrote #{path}."
end
